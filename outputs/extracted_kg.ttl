focosa-f:WholeGrainWheatBread
    a focosa-f:FoodItem ;
    rdfs:label "Whole grain wheat bread" ;
    schema:suitableForDiet focosa-h:VeganDiet
    {|
        llm:LLM_id "deepseek-chat" ;
        llm:validationMethod "shacl" ;
